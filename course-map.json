      ],
      "outputs": [
        "outputs/content/revision-notes.md"
      ],
      "acceptance": [
        "保留原稿與修改理由",
        "沒有添加不存在的故事、數字或承諾"
      ]
    },
    {
      "id": "research",
      "order": 10,
      "title": "Tavily 串接與定位研究",
      "tier": "core",
      "depends_on": [
        "human"
      ],
      "guide": "stages/research.md",
      "classroom_source": "C4385，00:00–22:23",
      "student_inputs": [
        "服務對象與研究問題",
