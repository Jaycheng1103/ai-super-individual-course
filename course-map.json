{
  "schema": 2,
  "version": "2.0.0",
  "sequence_note": "課堂版承接已建立的 Codex 專案與已手動連接的外掛；前三階段合併為一次開場處理，立即安全安裝 AIS-OS 後訪談。雲端功能在首次實際使用時驗證。後續依原課堂順序；first-video 為統一驗收點。",
  "stages": [
    {
      "id": "environment",
      "order": 1,
      "title": "確認課前專案與環境",
      "tier": "core",
      "depends_on": [],
      "guide": "stages/environment.md",
      "classroom_source": "C4376，00:00、33:32、42:37 起",
      "student_inputs": [
        "沿用目前 Codex 專案與已知環境，只有無法判定時才詢問"
      ],
      "actions": [
        "唯讀確認目前專案與必要工具",
        "接續 AIS-OS 安裝後回填環境證據"
      ],
      "outputs": [
        ".course/learning-brief.md"
      ],
      "acceptance": [
        "AI 能讀教材與目前專案",
        "目前專案位置明確且可承接 AIS-OS"
      ]
    },
    {
      "id": "connectors",
      "order": 2,
      "title": "沿用課前外掛設定",
      "tier": "core",
      "depends_on": [
        "environment"
      ],
      "guide": "stages/connectors.md",
      "classroom_source": "C4377，00:00 起",
      "student_inputs": [
        "講師課前已帶學員手動連接外掛；未知項目如實記錄"
      ],
      "actions": [
        "沿用現有設定，不重做連接",
        "功能實測留到首次使用指定資料時進行"
      ],
      "outputs": [
        ".course/connections.md"
      ],
      "acceptance": [
        "設定狀態及證據來源已記錄",
        "功能實測狀態獨立標示，未測不宣稱成功"
      ]
    },
    {
      "id": "workspace",
      "order": 3,
      "title": "建立 AI 第二大腦",
      "tier": "core",
      "depends_on": [
        "connectors"
      ],
      "guide": "stages/workspace.md",
      "classroom_source": "C4378，00:00–03:06",
      "student_inputs": [
        "目前 Codex 專案的實際路徑，能自行確認就不再問"
      ],
      "actions": [
        "安裝 AIS-OS 並讀回六個技能",
        "在私人庫完成檔案寫入與讀回"
      ],
      "outputs": [
        "AGENTS.md",
        "CLAUDE.md",
        "aios-intake.md"
      ],
      "acceptance": [
        "六個技能與附件存在",
        "學員能開啟自己的資料與測試摘要"
      ]
    },
    {
      "id": "background",
      "order": 4,
      "title": "背景訪談與補足資料",
      "tier": "core",
      "depends_on": [
        "workspace"
      ],
      "guide": "stages/background.md",
      "classroom_source": "C4378，07:14 起；C4379；C4380，02:10 起",
      "student_inputs": [
        "本人背景與近期目標",
        "1–2 份本人文字樣本"
      ],
      "actions": [
        "依 onboard 七個主題逐題訪問",
        "本人核對背景，再以 audit、grill-me 補缺口"
      ],
      "outputs": [
        "context/about-me.md",
        "references/voice.md",
        ".course/interview.md"
      ],
      "acceptance": [
        "背景、目標與語氣能指回本人確認的資料",
        "未答題與待確認資訊明確保留"
      ]
    },
    {
      "id": "knowledge",
      "order": 5,
      "title": "整理知識與索引",
      "tier": "core",
      "depends_on": [
        "background"
      ],
      "guide": "stages/knowledge.md",
      "classroom_source": "C4380，03:53–05:19",
      "student_inputs": [
        "三份願意練習的自有資料",
        "兩個工作上會問的問題"
      ],
      "actions": [
        "保留原件、建立摘要與索引",
        "使用 link 建立資料路由並測試問答"
      ],
      "outputs": [
        "knowledge/wiki/index.md"
      ],
      "acceptance": [
        "問答能引用正確原件",
        "找不到的答案明確標示不足"
      ]
    },
    {
      "id": "daily-work",
      "order": 6,
      "title": "讓 AI 完成一項日常工作",
      "tier": "core",
      "depends_on": [
        "knowledge"
      ],
      "guide": "stages/daily-work.md",
      "classroom_source": "C4382，02:24–11:33",
      "student_inputs": [
        "一份可用的會議記錄或工作文件",
        "希望交付的格式與位置"
      ],
      "actions": [
        "確認起點、目的地與限制",
        "整理指定資料，實際打開成果"
      ],
      "outputs": [
        "outputs/daily-work/summary.md"
      ],
      "acceptance": [
        "內容符合指定來源與日期",
        "交付檔案可讀；雲端結果另行驗證"
      ]
    },
    {
      "id": "skills",
      "order": 7,
      "title": "安裝行銷與創作能力",
      "tier": "core",
      "depends_on": [
        "daily-work"
      ],
      "guide": "stages/skills.md",
      "classroom_source": "C4382，13:50–16:53；Agent Reach 為講師 2026-09-22 新增",
      "student_inputs": [
        "目前使用的 agent",
        "下一步要做的內容類型"
      ],
      "actions": [
        "依序安裝 Marketing Skills、Agent Reach 與內容三件組",
        "讀回技能及附件，依 Agent Reach 指引安裝隔離 CLI、診斷並實測公開 RSS",
        "用真實工作目標產出內容規劃，保存版本、測試結果與斷點"
      ],
      "outputs": [
        ".course/installed.json",
        ".course/agent-reach-check.md"
      ],
      "acceptance": [
        "agent 能讀取指定 SKILL.md 及 references",
        "用真實工作目標產出一份內容規劃",
        "Agent Reach CLI 可執行；公開 RSS 實測取得非空標題與網址，未設定平台不列為已可用"
      ]
    },
    {
      "id": "content",
      "order": 8,
      "title": "近況訪談與內容三件組",
      "tier": "core",
      "depends_on": [
        "skills"
      ],
      "guide": "stages/content.md",
      "classroom_source": "C4383，05:00 起；C4384 前段",
      "student_inputs": [
        "最近一個月的一件真實事件",
        "受眾、觀點與可使用照片"
      ],
      "actions": [
        "一次一題取得事件素材",
        "依序完成 FB 長文、短影音腳本與輪播規劃"
      ],
      "outputs": [
        "sources/recent-experience.md",
        "outputs/content/facebook.md",
        "outputs/content/reels.md",
        "outputs/content/carousel.md"
      ],
      "acceptance": [
        "三份草稿均可追溯同一份真實素材",
        "本人至少完整修改一份；待補圖像有標示"
      ]
    },
    {
      "id": "human",
      "order": 9,
      "title": "修正文案語氣",
      "tier": "core",
      "depends_on": [
        "content"
      ],
      "guide": "stages/human.md",
      "classroom_source": "C4384，04:42–06:47；C4385，22:23 起",
      "student_inputs": [
        "上一階段草稿",
