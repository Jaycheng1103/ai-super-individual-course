      ],
      "actions": [
        "設定與測試 Tavily",
        "研究 1–3 個競品，整理定位及產品假設"
      ],
      "outputs": [
        "outputs/research/positioning.md"
      ],
      "acceptance": [
        "每項主要事實有原始網址與日期",
        "定位與價格提案標為待驗證假設"
      ]
    },
    {
      "id": "recording",
      "order": 11,
      "title": "訪談練習與拍攝素材",
